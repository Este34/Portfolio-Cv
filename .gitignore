# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Clone vide créé par erreur dans le dossier du projet — conservé sur disque,
# non suivi. Supprimable sans risque.
/Portfolio/

# Captures de vérification visuelle — locales, non versionnées.
/.captures/

# Sorties de Playwright. Les images de référence, elles, SONT versionnées :
# elles vivent dans tests-visuels/*-snapshots/ et constituent l'attendu contre
# lequel la suite compare. Ce qui est ignoré ici, ce sont les rapports et les
# images produites par un échec.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Rapports Lighthouse CI, produits localement par `npx @lhci/cli autorun`.
# Les seuils, eux, sont versionnés dans `lighthouserc.json`.
/.lighthouseci/
