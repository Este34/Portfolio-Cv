{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run generer:donnees && next dev",
    "prebuild": "npm run verifier:anonymat && npm run generer:donnees && npm run verifier:embeddings",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "generer:donnees": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generer-donnees.ts",
    "generer:embeddings": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generer-embeddings.ts",
    "verifier:anonymat": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verifier-anonymat.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verifier:embeddings": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verifier-embeddings.ts"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "@huggingface/transformers": "^4.2.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hyparquet": "^1.28.2",
    "hyparquet-writer": "^0.16.6",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "next": "^16.3.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
