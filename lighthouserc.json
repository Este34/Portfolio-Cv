{
  "ci": {
    "collect": {
      "startServerCommand": "npm start",
      "startServerReadyPattern": "Ready|started server",
      "url": [
        "http://localhost:3000/fr",
        "http://localhost:3000/fr/travaux",
        "http://localhost:3000/fr/travaux/pipeline-comtrade",
        "http://localhost:3000/fr/parcours",
        "http://localhost:3000/fr/evaluations",
        "http://localhost:3000/fr/notes/un-champ-vide-ne-vaut-pas-zero"
      ],
      "numberOfRuns": 2,
      "settings": {
        "preset": "desktop"
      }
    },
    "assertMatrix": [
      {
        "matchingUrlPattern": ".*/fr$",
        "assertions": {
          "categories:performance": [
            "error",
            {
              "minScore": 0.9
            }
          ],
          "categories:accessibility": [
            "error",
            {
              "minScore": 1
            }
          ],
          "categories:best-practices": [
            "error",
            {
              "minScore": 1
            }
          ],
          "categories:seo": [
            "error",
            {
              "minScore": 1
            }
          ],
          "total-byte-weight": [
            "error",
            {
              "maxNumericValue": 750000
            }
          ]
        }
      },
      {
        "matchingUrlPattern": ".*/fr/.+",
        "assertions": {
          "categories:performance": [
            "error",
            {
              "minScore": 0.9
            }
          ],
          "categories:accessibility": [
            "error",
            {
              "minScore": 1
            }
          ],
          "categories:best-practices": [
            "error",
            {
              "minScore": 1
            }
          ],
          "categories:seo": [
            "error",
            {
              "minScore": 1
            }
          ],
          "total-byte-weight": [
            "error",
            {
              "maxNumericValue": 480000
            }
          ]
        }
      }
    ],
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
