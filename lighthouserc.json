{
  "ci": {
    "collect": {
      "startServerCommand": "npm start",
      "startServerReadyPattern": "Ready|started server",
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/travaux",
        "http://localhost:3000/travaux/pipeline-comtrade",
        "http://localhost:3000/parcours"
      ],
      "numberOfRuns": 2,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.97 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],

        "//": "Le poids du premier rendu est la contrainte structurante du site : DuckDB et le modèle de vectorisation ne doivent jamais y entrer.",
        "total-byte-weight": ["error", { "maxNumericValue": 400000 }],
        "unused-javascript": ["warn", { "maxLength": 1 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
